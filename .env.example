# ==============================================================================
# HelpDesk+ Environment Configuration Template
# Copy this file to .env and fill in your local credentials.
# DO NOT commit the .env file to Git!
# ==============================================================================

# Server & App Config
PORT=3000
NODE_ENV=development
API_PREFIX=/api/v1
FRONTEND_URL=http://localhost:5173

# Database (PostgreSQL 16)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=helpdesk_db
DB_SYNCHRONIZE=true
DB_LOGGING=false

# Cache & Message Queue (Redis 7 & BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Security & Authentication (JWT)
JWT_SECRET=helpdesk_plus_super_secret_jwt_key_2026
JWT_EXPIRES_IN=7d

# AI Integration (LLM Engine)
# Supported providers: gemini | openai
LLM_PROVIDER=gemini
LLM_API_KEY=your_gemini_or_openai_api_key_here
LLM_MODEL=gemini-1.5-flash

# Multi-channel Integration: Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_WEBHOOK_URL=http://your-domain.ngrok-free.app/api/v1/channels/telegram/webhook

# Multi-channel Integration: Email (IMAP & SMTP)
EMAIL_IMAP_HOST=imap.gmail.com
EMAIL_IMAP_PORT=993
EMAIL_IMAP_SECURE=true
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_USER=your_helpdesk_support@gmail.com
EMAIL_PASSWORD=your_gmail_app_password
EMAIL_FROM=your_helpdesk_support@gmail.com
EMAIL_FROM_NAME="HelpDesk+ Support Team"
